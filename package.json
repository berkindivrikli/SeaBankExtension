{
  "name": "seabank-extension",
  "displayName": "SeaBank Extension",
  "description": "Custom keyboard shortcuts for SQL query execution via MSSQL. Define key combinations mapped to SQL templates and execute them with selected text substitution.",
  "version": "0.0.1",
  "publisher": "BERKIND",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "mssql",
    "shortcuts",
    "ssms",
    "query"
  ],
  "activationEvents": [
    "onView:seabankShortcutsList",
    "onCommand:seabank.addShortcut",
    "onCommand:seabank.editShortcut",
    "onCommand:seabank.deleteShortcut",
    "onCommand:seabank.runShortcut0",
    "onCommand:seabank.runShortcut1",
    "onCommand:seabank.runShortcut2",
    "onCommand:seabank.runShortcut3",
    "onCommand:seabank.runShortcut4",
    "onCommand:seabank.runShortcut5",
    "onCommand:seabank.runShortcut6",
    "onCommand:seabank.runShortcut7",
    "onCommand:seabank.runShortcut8",
    "onCommand:seabank.runShortcut9"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "seabank-shortcuts",
          "title": "SeaBank Extension",
          "icon": "media/seabank-activity-solid.svg"
        }
      ]
    },
    "views": {
      "seabank-shortcuts": [
        {
          "id": "seabankShortcutsList",
          "name": "SeaBank Shortcuts"
        }
      ]
    },
    "commands": [
      {
        "command": "seabank.addShortcut",
        "title": "Add SQL Shortcut",
        "icon": "$(add)"
      },
      {
        "command": "seabank.editShortcut",
        "title": "Edit Shortcut",
        "icon": "$(edit)"
      },
      {
        "command": "seabank.deleteShortcut",
        "title": "Delete Shortcut",
        "icon": "$(trash)"
      },
      {
        "command": "seabank.runShortcut1",
        "title": "SeaBank: Run SQL Shortcut 1"
      },
      {
        "command": "seabank.runShortcut2",
        "title": "SeaBank: Run SQL Shortcut 2"
      },
      {
        "command": "seabank.runShortcut3",
        "title": "SeaBank: Run SQL Shortcut 3"
      },
      {
        "command": "seabank.runShortcut4",
        "title": "SeaBank: Run SQL Shortcut 4"
      },
      {
        "command": "seabank.runShortcut5",
        "title": "SeaBank: Run SQL Shortcut 5"
      },
      {
        "command": "seabank.runShortcut6",
        "title": "SeaBank: Run SQL Shortcut 6"
      },
      {
        "command": "seabank.runShortcut7",
        "title": "SeaBank: Run SQL Shortcut 7"
      },
      {
        "command": "seabank.runShortcut8",
        "title": "SeaBank: Run SQL Shortcut 8"
      },
      {
        "command": "seabank.runShortcut9",
        "title": "SeaBank: Run SQL Shortcut 9"
      },
      {
        "command": "seabank.runShortcut0",
        "title": "SeaBank: Run SQL Shortcut 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "seabank.addShortcut",
          "when": "view == seabankShortcutsList",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "seabank.editShortcut",
          "when": "view == seabankShortcutsList",
          "group": "inline"
        },
        {
          "command": "seabank.deleteShortcut",
          "when": "view == seabankShortcutsList",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      { "command": "seabank.runShortcut1", "key": "ctrl+1", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut2", "key": "ctrl+2", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut3", "key": "ctrl+3", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut4", "key": "ctrl+4", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut5", "key": "ctrl+5", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut6", "key": "ctrl+6", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut7", "key": "ctrl+7", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut8", "key": "ctrl+8", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut9", "key": "ctrl+9", "when": "editorTextFocus && editorLangId == sql" },
      { "command": "seabank.runShortcut0", "key": "ctrl+0", "when": "editorTextFocus && editorLangId == sql" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.0.0"
  },
  "extensionDependencies": [
    "ms-mssql.mssql"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/berkindivrikli/SeaBankExtension.git"
  },
  "bugs": {
    "url": "https://github.com/berkindivrikli/SeaBankExtension/issues"
  },
  "homepage": "https://github.com/berkindivrikli/SeaBankExtension#readme",
  "galleryBanner": {
    "color": "#0B4F6C",
    "theme": "dark"
  }
}
